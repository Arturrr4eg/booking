# Скопируй в .env: cp .env.example .env
# Значения ниже подходят для локальной базы из docker-compose.yml.
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
DATABASE_URL=postgresql://booking:booking@localhost:5432/booking
# Адрес фронта, которому разрешены запросы к API (CORS).
WEB_ORIGIN=http://localhost:3000
JWT_SECRET=change-me-to-any-random-string-of-32-chars
